    // =========================================================================
    // 12. STRICT ZERO-ALLOCATION DELTA-TIME (`dt`) PHYSICS & RENDER LOOP
    // =========================================================================
    let frameCount = 0;
    let fpsAccum = 0;
    let currentFps = 60;
    let totalSimTime = 0;

    function animate() {
      requestAnimationFrame(animate);

      const dt = Math.min(clock.getDelta(), 0.1);
      totalSimTime += dt;
      frameCount++;
      fpsAccum += dt;
      if (fpsAccum >= 0.5) {
        currentFps = Math.round(frameCount / fpsAccum);
        frameCount = 0;
        fpsAccum = 0;
        document.getElementById('gpu-val').textContent =
          `${currentFps} FPS | dt: ${(dt * 1000).toFixed(1)}ms | 0 Allocs/f`;
      }

      if (state.portalJumpCooldownSec > 0) {
        state.portalJumpCooldownSec = Math.max(0, state.portalJumpCooldownSec - dt);
      }

      const activeObj = state.mothershipControl ? mothershipGroup : shipGroup;

      // FIX 3: Dynamic Higgs Field Suppression & Effective Inertial Mass (m_eff)
      const targetSuppression = state.bubbleActive ? 0.999999 : 0.0;
      state.higgsSuppression += (targetSuppression - state.higgsSuppression) * Math.min(1.0, 6.0 * dt);
      // Clamp floor so F / m_eff stays finite while resolving 0/0 photon-like state
      state.effectiveMassKg = state.restMassKg * Math.max(0.08, 1.0 - state.higgsSuppression);
      const dispMassKg = state.higgsSuppression > 0.99 ? 0.0 : state.effectiveMassKg;

      // 1. 6-DOF Rotational Kinematics (Pitch: Arrows, Yaw: Arrows, Roll: Q/E)
      const massRatio = state.restMassKg / state.effectiveMassKg; // Rises up to 12.5x as m_eff -> 0
      const angAccel = 1.8 * Math.min(3.0, Math.sqrt(massRatio));
      let pitchInput = (state.keys['arrowup'] ? 1 : 0) - (state.keys['arrowdown'] ? 1 : 0) + state.joyRight.y;
      let yawInput = (state.keys['arrowleft'] ? 1 : 0) - (state.keys['arrowright'] ? 1 : 0) - state.joyRight.x;
      let rollInput = (state.keys['q'] ? 1 : 0) - (state.keys['e'] ? 1 : 0);

      if (state.mouseSteer) {
        pitchInput += state.mouseY * 1.3;
        yawInput -= state.mouseX * 1.3;
      }

      state.angularVel.x += pitchInput * angAccel * dt;
      state.angularVel.y += yawInput * angAccel * dt;
      state.angularVel.z += rollInput * angAccel * 1.4 * dt;

      const rotDamp = Math.exp(-(state.inertialDampers ? 4.5 : 0.4) * dt);
      state.angularVel.multiplyScalar(rotDamp);

      activeObj.rotateX(state.angularVel.x * dt);
      activeObj.rotateY(state.angularVel.y * dt);
      activeObj.rotateZ(state.angularVel.z * dt);

      // 2. FIX 7: Full 6-DOF Translational Axes (Surge W/S, Strafe A/D, Vertical Heave R/F)
      _forward.set(0, 0, -1).applyQuaternion(activeObj.quaternion);
      _right.set(1, 0, 0).applyQuaternion(activeObj.quaternion);
      _up.set(0, 1, 0).applyQuaternion(activeObj.quaternion);

      const surgeInput = (state.keys['w'] ? 1 : 0) - (state.keys['s'] ? 0.7 : 0) + state.joyLeft.y;
      const strafeInput = (state.keys['d'] ? 1 : 0) - (state.keys['a'] ? 1 : 0) + state.joyLeft.x;
      const heaveInput = (state.keys['r'] ? 1 : 0) - (state.keys['f'] ? 1 : 0); // Vertical translation!

      // Acceleration a = F_rcs / m_eff
      const linAccelMag = state.rcsForceN / state.effectiveMassKg;
      _v1.set(0, 0, 0);
      _v1.addScaledVector(_forward, surgeInput * linAccelMag);
      _v1.addScaledVector(_right, strafeInput * linAccelMag * 0.75);
      _v1.addScaledVector(_up, heaveInput * linAccelMag * 0.75);

      // Add Keplerian Gravity when Higgs Coupled
      computeGravityAccelInPlace(activeObj.position, _gAcc);
      _v1.add(_gAcc);

      // G-Force Telemetry (0.00G inside 0/0 Bubble; real G-load when Higgs coupled)
      state.gLoad = (1.0 - state.higgsSuppression) * (_v1.length() / 9.81);

      state.linearVel.addScaledVector(_v1, dt);
      if (state.inertialDampers) {
        state.linearVel.multiplyScalar(Math.exp(-1.15 * dt));
      }

      // FIX 2: Honest Local Frame Velocity vs. ADM Metric Contraction Streaming
      const targetAdm = state.spacePuller ? 365000.0 : (state.bubbleActive ? 12.4 : 1.0);
      state.admContractionFactor += (targetAdm - state.admContractionFactor) * Math.min(1.0, 4.0 * dt);

      // Move ship in local coordinates
      activeObj.position.addScaledVector(state.linearVel, dt);

      // Stream starfield & cosmic objects opposite to forward vector during ADM Metric Contraction
      const localSpeedMS = state.linearVel.length();
      state.metricSpeedC = state.spacePuller
        ? state.admContractionFactor * (1.0 + localSpeedMS / 500.0)
        : (state.bubbleActive ? (localSpeedMS / 40.0) : (localSpeedMS / 299792458.0));

      const starArr = starGeo.attributes.position.array;
      const streamStep = state.spacePuller ? 1600 * dt : 0;
      if (streamStep > 0) {
        for (let i = 0; i < starCount * 3; i += 3) {
          starArr[i] -= _forward.x * streamStep;
          starArr[i + 1] -= _forward.y * streamStep;
          starArr[i + 2] -= _forward.z * streamStep;
          if (Math.abs(starArr[i + 2] - activeObj.position.z) > 4000) {
            starArr[i + 2] = activeObj.position.z - 3800;
          }
        }
        starGeo.attributes.position.needsUpdate = true;
      }

      // Animate 3D Cosmic Zone Geometries
      if (state.systemIdx === 0) {
        for (let i = 0; i < oortComets.length; i++) {
          const c = oortComets[i];
          c.position.z += (localSpeedMS * 0.6 + (state.spacePuller ? 450 : 25)) * dt;
          if (c.position.z - oortGroup.position.z > 1200) c.position.z -= 2400;
        }
      } else if (state.systemIdx === 2) {
        spiralGalaxyMesh.rotation.y += 0.18 * dt;
      } else if (state.systemIdx === 3) {
        cosmicWebLines.rotation.y += 0.06 * dt;
      } else if (state.systemIdx === 4) {
        for (let i = 0; i < bubbleUniverses.length; i++) {
          bubbleUniverses[i].rotation.y += 0.35 * dt;
        }
      }

      updateOrbitalTrajectoryLine(activeObj.position, state.linearVel);
      updateSpacetimeMetricGrid(activeObj, _forward, totalSimTime);

      // Emit Pooled Engine Thruster Particles (Zero Allocation)
      _v2.set(0, -0.2, 6.5).applyQuaternion(activeObj.quaternion).add(activeObj.position);
      emitPooledParticles(_v2, state.spacePuller ? 0.8 : 0.0, 0.95, 1.0, 2, 18, 0.35);

      // 3. FIX 4: Phase-Shift Capacitor Drain & Tier-4 0.05s (50ms) Nanolattice Auto-Heal
      if (state.phaseShift) {
        state.capacitorEJ = Math.max(0, state.capacitorEJ - 6.0 * dt);
        if (state.capacitorEJ <= 0) togglePhase(); // Collapses if capacitor empty
      }
      if (state.nanoHealTimerSec > 0) {
        state.nanoHealTimerSec -= dt;
        if (state.nanoHealTimerSec <= 0) {
          state.hullIntegrity = Math.min(100, state.hullIntegrity + 8);
          document.getElementById('nano-val').textContent = '0.05s Nanolattice Re-Bonded!';
        }
      }

      // 4. Real 120.00s Armada Countdown & FIX 1 Single-Trigger Portal Entry
      if (state.armadaSyncing) {
        const timeRate = state.fastCountdown ? 10.0 : 1.0;
        state.armadaCountdownSec = Math.max(0, state.armadaCountdownSec - dt * timeRate);
        const tRem = state.armadaCountdownSec;
        const cdBanner = document.getElementById('countdown-banner');

        if (tRem > 60) {
          if (!state.stageTriggered.s120) {
            state.stageTriggered.s120 = true;
            if (!state.wingmenActive) toggleWingmen();
          }
          cdBanner.textContent = `T - ${tRem.toFixed(2)}s [STAGE 1]: 240+ ESCORT SQUADRONS IN 3D SPHERICAL FORMATION`;
        } else if (tRem > 30) {
          if (!state.stageTriggered.s60) {
            state.stageTriggered.s60 = true;
            shuntPortalMass();
          }
          cdBanner.textContent = `T - ${tRem.toFixed(2)}s [STAGE 2]: PORTAL BLEEDING 10⁴ kg/s → 899 EW | THROAT 920m OPEN`;
        } else if (tRem > 5) {
          if (!state.stageTriggered.s30) {
            state.stageTriggered.s30 = true;
            goldenTether.material.opacity = 0.9;
          }
          const posArr = goldenTether.geometry.attributes.position.array;
          posArr[0] = mothershipGroup.position.x; posArr[1] = mothershipGroup.position.y; posArr[2] = mothershipGroup.position.z;
          posArr[3] = portalGroup.position.x; posArr[4] = portalGroup.position.y; posArr[5] = portalGroup.position.z;
          goldenTether.geometry.attributes.position.needsUpdate = true;
          cdBanner.textContent = `T - ${tRem.toFixed(2)}s [STAGE 3]: GOLDEN PLASMA TETHER COUPLED | WORMHOLE LOCK 100%`;
        } else if (tRem > 0) {
          cdBanner.textContent = `T - ${tRem.toFixed(2)}s [STAGE 4]: 12 MOTHERSHIP CORES AT 0.00 kg — JUMP IMMINENT!`;
        } else {
          completeArmadaJump();
        }
      }

      if (state.portalJumpCooldownSec <= 0 && activeObj.position.distanceTo(portalGroup.position) < 92) {
        completeArmadaJump();
      }

      // 5. Mothership 360° Turrets & Wingmen (Zero Allocation)
      for (let t = 0; t < msTurrets.length; t++) {
        const tur = msTurrets[t];
        tur.cooldown -= dt;
        let nearestEn = null;
        let minDist = 850;
        for (let e = 0; e < enemies.length; e++) {
          const d = enemies[e].mesh.position.distanceTo(mothershipGroup.position);
          if (d < minDist) { minDist = d; nearestEn = enemies[e]; }
        }
        if (nearestEn) {
          tur.pivot.lookAt(nearestEn.mesh.position);
          if (tur.cooldown <= 0) {
            tur.cooldown = 1.1 + Math.random() * 0.5;
            tur.pivot.getWorldPosition(_worldTurPos);
            _v3.subVectors(nearestEn.mesh.position, _worldTurPos).normalize();
            spawnPooledProjectile(_worldTurPos, _v3, 560, 0xffdd00, false, false);
          }
        }
      }

      if (state.wingmenActive) {
        for (let i = 0; i < wingmen.length; i++) {
          const w = wingmen[i];
          w.angle += 1.6 * dt;
          const r = 28 + (i % 2) * 12;
          w.mesh.position.set(
            activeObj.position.x + Math.cos(w.angle) * r,
            activeObj.position.y + Math.sin(w.angle * 1.3) * 14,
            activeObj.position.z + Math.sin(w.angle) * r
          );
          w.mesh.quaternion.copy(activeObj.quaternion);
          w.cooldown -= dt;
          if (w.cooldown <= 0) {
            w.cooldown = 0.9 + Math.random() * 0.6;
            for (let e = 0; e < enemies.length; e++) {
              if (enemies[e].mesh.position.distanceTo(w.mesh.position) < 600) {
                _v3.subVectors(enemies[e].mesh.position, w.mesh.position).normalize();
                spawnPooledProjectile(w.mesh.position, _v3, 540, 0xbc13fe, false, false);
                break;
              }
            }
          }
        }
      }

      // 6. Enemy AI State Machine (Zero Allocation)
      for (let i = 0; i < enemies.length; i++) {
        const en = enemies[i];
        _v1.subVectors(activeObj.position, en.mesh.position);
        const dist = _v1.length();
        _v2.copy(_v1).normalize();

        if (dist > 360) {
          en.aiState = 'APPROACH';
          _v3.copy(_v2).multiplyScalar(115);
          en.vel.lerp(_v3, 2.5 * dt);
        } else if (dist > 130) {
          en.aiState = 'ORBIT_STRAFE';
          _v3.set(-_v2.z * en.strafeDir, 0.15, _v2.x * en.strafeDir).normalize().multiplyScalar(95);
          en.vel.lerp(_v3, 3.0 * dt);
        } else {
          en.aiState = 'EVADE';
          _v3.copy(_v2).negate().multiplyScalar(130);
          en.vel.lerp(_v3, 3.5 * dt);
        }

        en.mesh.position.addScaledVector(en.vel, dt);
        en.mesh.rotation.x += 1.2 * dt;
        en.mesh.rotation.y += 1.5 * dt;

        en.fireCooldown -= dt;
        if (en.fireCooldown <= 0 && dist < 680) {
          en.fireCooldown = 2.2 + Math.random() * 1.5;
          const timeToHit = dist / 380;
          _v3.copy(activeObj.position).addScaledVector(state.linearVel, timeToHit * 0.5).sub(en.mesh.position).normalize();
          spawnPooledProjectile(en.mesh.position, _v3, 380, 0xff0044, true, false);
        }
      }

      bossGroup.lookAt(activeObj.position);
      bossCooldownSec -= dt;
      if (bossCooldownSec <= 0) {
        bossCooldownSec = 2.8;
        if (bossGroup.position.distanceTo(activeObj.position) < 1200) {
          _v3.subVectors(activeObj.position, bossGroup.position).normalize();
          spawnPooledProjectile(bossGroup.position, _v3, 440, 0xff3300, true, true);
        }
      }

      // 7. Projectile Pool & FIX 4 Probabilistic 98% Phase-Shift Check
      for (let i = 0; i < MAX_PROJECTILES; i++) {
        const p = projectilePool[i];
        if (p.life <= 0) continue;

        p.mesh.position.addScaledVector(p.vel, dt);
        p.life -= dt;
        if (p.life <= 0) {
          p.mesh.visible = false;
          continue;
        }

        if (p.isHostile) {
          if (p.mesh.position.distanceTo(activeObj.position) < 16) {
            p.life = 0;
            p.mesh.visible = false;
            if (state.phaseShift) {
              // FIX 4: Exact 98% Quantum Tunneling vs 2% Residual Quantum Phase-Shear Graze!
              if (Math.random() < 0.98) {
                state.tunneledCount++;
                document.getElementById('nano-val').textContent = `98% Phase Tunneled (#${state.tunneledCount})`;
                showAlert('98% QUANTUM PHASE-SHIFT: HOSTILE SHOT TUNNELED HARMLESSLY!', '#bc13fe');
              } else {
                state.shearGrazeCount++;
                state.hullIntegrity = Math.max(20, state.hullIntegrity - 9);
                state.nanoHealTimerSec = 0.05; // Trigger 50ms Tier-4 Nanolattice Self-Repair!
                document.getElementById('nano-val').textContent = '2% Shear Graze! 0.05s Nano-Healing...';
                showAlert('2% QUANTUM PHASE-SHEAR GRAZE! TIER-4 NANOLATTICE RE-BONDING IN 0.05s!', '#ff3366');
              }
            } else {
              hexShieldMat.opacity = 0.9;
              const recEJ = p.isPlasma ? 24 : 12;
              state.capacitorEJ = Math.min(250, state.capacitorEJ + recEJ);
              state.totalHarvestedEJ += recEJ;
              state.hullIntegrity = Math.max(25, state.hullIntegrity - (p.isPlasma ? 8 : 3));
              state.nanoHealTimerSec = 0.05;
              emitPooledParticles(activeObj.position, 1.0, 0.75, 0.1, 16, 70, 0.5);
              showAlert(`TIER-2 HEX COILS REDIRECTED 92% HOSTILE IMPACT (+${recEJ} EJ TO CAPACITOR!)`, '#00ff88');
            }
          }
        } else {
          for (let e = 0; e < enemies.length; e++) {
            const en = enemies[e];
            if (p.mesh.position.distanceTo(en.mesh.position) < (p.isPlasma ? 24 : 15)) {
              p.life = 0;
              p.mesh.visible = false;
              emitPooledParticles(en.mesh.position, 1.0, 0.35, 0.0, 30, 110, 0.75);
              respawnEnemy(en);
              state.capacitorEJ = Math.min(250, state.capacitorEJ + 10);
              state.totalHarvestedEJ += 10;
              playTone(320, 90, 0.15, 'triangle');
              showAlert('HOSTILE CRUISER VAPORIZED! +10 EJ HARVESTED', '#00ffcc');
              break;
            }
          }
          if (p.life > 0 && p.mesh.position.distanceTo(bossGroup.position) < 52) {
            p.life = 0;
            p.mesh.visible = false;
            state.bossHull = Math.max(0, state.bossHull - (p.isPlasma ? 16 : 4));
            emitPooledParticles(p.mesh.position, 0.8, 0.1, 1.0, 20, 90, 0.6);
            if (state.bossHull <= 0) {
              emitPooledParticles(bossGroup.position, 1.0, 0.2, 0.4, 90, 180, 1.2);
              state.bossHull = 100;
              bossGroup.position.z -= 900;
              showAlert('HOSTILE CAPITAL DREADNOUGHT DESTROYED!', '#00ff88');
            }
          }
        }
      }

      // 8. Update GPU Particle Buffer
      for (let i = 0; i < MAX_PARTICLES; i++) {
        if (partLifetimes[i] > 0) {
          partLifetimes[i] -= dt;
          if (partLifetimes[i] <= 0) {
            partPositions[i * 3 + 1] = -99999;
          } else {
            partPositions[i * 3] += partVelocities[i].x * dt;
            partPositions[i * 3 + 1] += partVelocities[i].y * dt;
            partPositions[i * 3 + 2] += partVelocities[i].z * dt;
          }
        }
      }
      particleGeo.attributes.position.needsUpdate = true;
      particleGeo.attributes.color.needsUpdate = true;

      if (hexShieldMat.opacity > 0) {
        hexShieldMat.opacity = Math.max(0, hexShieldMat.opacity - 1.8 * dt);
        hexShieldMesh.rotation.y += 4.0 * dt;
      }
      isolationBubble.rotation.y += 1.4 * dt;
      spacePullerCone.rotation.z -= 5.0 * dt;
      innerCasimirRing.rotation.z -= 2.2 * dt;
      wormholeFunnelMesh.rotation.z += 1.2 * dt;

      state.capacitorEJ = Math.min(250, state.capacitorEJ + 4.5 * dt);
      state.schStability = Math.min(100, state.schStability + 1.8 * dt);

      // 9. Zero-Allocation Smooth Chase Camera
      _v1.set(0, state.mothershipControl ? 35 : 10, state.mothershipControl ? 110 : 38)
         .applyQuaternion(activeObj.quaternion)
         .add(activeObj.position);
      camera.position.lerp(_v1, 1 - Math.exp(-8.0 * dt));

      _v2.copy(activeObj.position).addScaledVector(_forward, 80);
      camera.lookAt(_v2);

      if (state.shakeIntensity > 0.05) {
        camera.position.x += (Math.random() - 0.5) * state.shakeIntensity;
        camera.position.y += (Math.random() - 0.5) * state.shakeIntensity;
        state.shakeIntensity *= Math.exp(-7.0 * dt);
      }

      // 10. Refresh Audited Telemetry HUD
      drawTacticalRadar(activeObj);
      document.getElementById('mass-val').textContent = dispMassKg === 0
        ? `0.00 kg (0/0 Higgs Decoupled)`
        : `${dispMassKg.toExponential(2)} kg`;
      document.getElementById('mass-val').className = dispMassKg === 0 ? 'val' : 'val warn';

      document.getElementById('local-speed-val').textContent =
        `${localSpeedMS.toFixed(1)} m/s (${state.gLoad.toFixed(2)}G Load)`;
      document.getElementById('metric-speed-val').textContent = state.spacePuller
        ? `${Math.round(state.metricSpeedC).toLocaleString()} c (ADM Contracted)`
        : `${state.metricSpeedC.toFixed(4)} c (Sub-Warp)`;

      document.getElementById('eq-1').textContent =
        `m_eff = ${dispMassKg.toExponential(2)} kg | a_max = ${(state.rcsForceN / state.effectiveMassKg).toFixed(0)} m/s²`;
      document.getElementById('eq-2').textContent =
        `Λ_ADM = ${state.admContractionFactor.toFixed(1)}x | v_eff = ${state.metricSpeedC.toFixed(2)} c`;
      document.getElementById('eq-3').textContent =
        `b(r₀) = 460m | Cooldown: ${state.portalJumpCooldownSec > 0 ? state.portalJumpCooldownSec.toFixed(1) + 's' : 'Ready'}`;
      document.getElementById('eq-4').textContent =
        `98% Tunneled: ${state.tunneledCount} | 2% Shear Grazes: ${state.shearGrazeCount}`;

      document.getElementById('cap-text').textContent = `${Math.round(state.capacitorEJ)} EJ`;
      document.getElementById('cap-bar').style.width = `${(state.capacitorEJ / 250) * 100}%`;
      document.getElementById('conduit-text').textContent = `${Math.round(state.conduitIntegrity)}%`;
      document.getElementById('conduit-bar').style.width = `${state.conduitIntegrity}%`;
      document.getElementById('boss-text').textContent = `${Math.round(state.bossHull)}%`;
      document.getElementById('boss-bar').style.width = `${state.bossHull}%`;
      document.getElementById('sch-text').textContent = `${Math.round(state.schStability)}%`;
      document.getElementById('sch-bar').style.width = `${state.schStability}%`;
      document.getElementById('hull-text').textContent = `${Math.round(state.hullIntegrity)}%`;
      document.getElementById('hull-bar').style.width = `${state.hullIntegrity}%`;

      renderer.render(scene, camera);
    }

    animate();
  </script>
</body>
</html>