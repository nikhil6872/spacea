    function bindVirtualJoystick(zoneId, knobId, outObj) {
      const zone = document.getElementById(zoneId);
      const knob = document.getElementById(knobId);
      let activeTouchId = null;
      let draggingMouse = false;

      function updateStick(clientX, clientY) {
        const rect = zone.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const maxR = rect.width / 2 - 16;
        let dx = clientX - cx;
        let dy = clientY - cy;
        const dist = Math.hypot(dx, dy);
        if (dist > maxR) {
          dx = (dx / dist) * maxR;
          dy = (dy / dist) * maxR;
        }
        knob.style.transform = `translate(${dx}px, ${dy}px)`;
        outObj.x = dx / maxR;
        outObj.y = -dy / maxR;
      }

      function resetStick() {
        knob.style.transform = 'translate(0px, 0px)';
        outObj.x = 0; outObj.y = 0;
      }

      zone.addEventListener('touchstart', (e) => {
        e.preventDefault();
        const t = e.changedTouches[0];
        activeTouchId = t.identifier;
        updateStick(t.clientX, t.clientY);
      }, { passive: false });

      zone.addEventListener('touchmove', (e) => {
        e.preventDefault();
        for (let i = 0; i < e.changedTouches.length; i++) {
          if (e.changedTouches[i].identifier === activeTouchId) {
            updateStick(e.changedTouches[i].clientX, e.changedTouches[i].clientY);
          }
        }
      }, { passive: false });

      zone.addEventListener('touchend', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
          if (e.changedTouches[i].identifier === activeTouchId) {
            activeTouchId = null;
            resetStick();
          }
        }
      });

      zone.addEventListener('mousedown', (e) => { draggingMouse = true; updateStick(e.clientX, e.clientY); });
      window.addEventListener('mousemove', (e) => { if (draggingMouse) updateStick(e.clientX, e.clientY); });
      window.addEventListener('mouseup', () => { if (draggingMouse) { draggingMouse = false; resetStick(); } });
    }

